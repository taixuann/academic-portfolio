---
/**
 * AcademicPosterViewer.astro
 * Reusable component for presenting high-resolution academic conference posters.
 * Adheres to academic-poster-designer guidelines (jindongwang & posterskill inspired).
 */
interface Props {
  title: string;
  conference?: string;
  authors: string[];
  affiliations: string[];
  pdfUrl?: string;
  posterImage: string;
  previewHeight?: string;
}

const {
  title,
  conference = "Scientific Conference Presentation",
  authors,
  affiliations,
  pdfUrl,
  posterImage,
  previewHeight = "650px",
} = Astro.props;
---

<div class="academic-poster-container border border-neutral-800 bg-neutral-950/80 rounded-xl overflow-hidden my-8 shadow-2xl">
  <!-- Top Control Bar -->
  <div class="px-5 py-3.5 bg-neutral-900/90 border-b border-neutral-800 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
        CONFERENCE POSTER
      </span>
      <span class="text-xs text-neutral-400 font-sans truncate max-w-xs sm:max-w-md">
        {conference}
      </span>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="btn-open-modal"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-neutral-200 bg-neutral-800 hover:bg-neutral-700 transition"
        title="View Fullscreen High-Resolution"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0 0l-5-5m-7 11l-5 5m0 0h4m-4 0v-4m16 4v-4m0 4h-4m4 0l-5-5"/>
        </svg>
        Fullscreen
      </button>

      {pdfUrl && (
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-blue-600 hover:bg-blue-500 transition shadow-sm"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Download PDF
        </a>
      )}
    </div>
  </div>

  <!-- Interactive Poster Preview Frame -->
  <div class="relative bg-neutral-900 flex justify-center items-center overflow-hidden p-2 group cursor-zoom-in" id="poster-preview-wrapper" style={`min-height: ${previewHeight}`}>
    <img
      src={posterImage}
      alt={title}
      class="w-full h-auto max-h-[750px] object-contain rounded shadow-lg transition duration-200 group-hover:scale-[1.01]"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center pointer-events-none">
      <span class="px-4 py-2 rounded-full bg-neutral-900/90 text-white text-xs font-mono tracking-wide border border-neutral-700 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
        </svg>
        Click to Inspect High-Resolution Poster
      </span>
    </div>
  </div>

  <!-- Metadata Summary -->
  <div class="p-4 bg-neutral-950 border-t border-neutral-800 text-xs text-neutral-400 flex flex-col sm:flex-row justify-between gap-2">
    <div>
      <span class="text-neutral-300 font-semibold">{authors.join(", ")}</span>
      <p class="text-neutral-500 mt-0.5">{affiliations.join(" • ")}</p>
    </div>
    <div class="text-right self-end sm:self-auto font-mono text-[11px] text-neutral-500">
      ISO A0 Landscape (1189 × 841 mm)
    </div>
  </div>
</div>

<!-- Fullscreen Inspection Modal -->
<dialog id="poster-modal" class="backdrop:bg-black/85 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto max-w-[95vw] max-h-[95vh] rounded-xl outline-none overflow-hidden">
  <div class="relative bg-neutral-950 border border-neutral-800 rounded-xl flex flex-col max-h-[92vh]">
    <div class="flex items-center justify-between px-4 py-2 bg-neutral-900 border-b border-neutral-800">
      <h4 class="text-sm font-medium text-neutral-200 truncate">{title}</h4>
      <button id="btn-close-modal" class="text-neutral-400 hover:text-white p-1 rounded hover:bg-neutral-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="overflow-auto p-4 flex justify-center items-center">
      <img src={posterImage} alt={title} class="max-w-full max-h-[82vh] object-contain rounded" />
    </div>
  </div>
</dialog>

<script>
  const openBtn = document.getElementById("btn-open-modal");
  const closeBtn = document.getElementById("btn-close-modal");
  const wrapper = document.getElementById("poster-preview-wrapper");
  const modal = document.getElementById("poster-modal") as HTMLDialogElement | null;

  if (modal) {
    const show = () => modal.showModal();
    const hide = () => modal.close();

    openBtn?.addEventListener("click", show);
    wrapper?.addEventListener("click", show);
    closeBtn?.addEventListener("click", hide);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) hide();
    });
  }
</script>
