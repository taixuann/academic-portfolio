---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Timeline from "../../components/ui/Timeline.astro";
import { PAGES } from "../../config";

if (PAGES.cv.isActive === false) {
    return Astro.redirect("/404");
}

const cvEntry = await getEntry("cv", "cv");
if (!cvEntry) {
    throw new Error(
        "CV content not found. Please ensure src/content/cv.md exists.",
    );
}

const { Content } = await render(cvEntry);
const { name, title, experience = [], education = [] } = cvEntry.data;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={PAGES.cv.title}>
    <header class="page-header mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="page-title">{PAGES.cv.title}</h1>
                <p class="page-subtitle">{PAGES.cv.subtitle}</p>
            </div>
            <a
                href={`${basePath}/academic-cv.pdf`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-accent text-white font-semibold text-sm hover:opacity-90 shadow-sm transition-all whitespace-nowrap self-start sm:self-auto"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                <span>Download CV (PDF)</span>
            </a>
        </div>
    </header>

    <div class="container-narrow">
        {
            education.length > 0 && (
                <section class="section mb-8">
                    <h2 class="section-title text-xl font-bold border-b border-border pb-2 mb-4">
                        Education
                    </h2>
                    <Timeline items={education.map(edu => ({
                        title: edu.degree,
                        subtitle: edu.institution,
                        period: edu.period,
                        description: edu.description,
                        thesis: edu.thesis
                    }))} />
                </section>
            )
        }

        {
            experience.length > 0 && (
                <section class="section mb-8">
                    <h2 class="section-title text-xl font-bold border-b border-border pb-2 mb-4">
                        Research & Academic Experience
                    </h2>
                    <Timeline items={experience.map(exp => ({
                        title: exp.role,
                        subtitle: exp.institution,
                        period: exp.period,
                        description: exp.description
                    }))} />
                </section>
            )
        }

        <div class="prose max-w-none">
            <Content />
        </div>
    </div>
</BaseLayout>
