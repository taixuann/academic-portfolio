---
/**
 * AcademicPosterViewer.astro
 * Conference Poster Viewer for Cryostat Project.
 * Integrates guidelines from jindongwang/poster_template & ethanweber/posterskill.
 */
interface Props {
  title?: string;
  conference?: string;
  authors?: string[];
  affiliations?: string[];
  pdfUrl?: string;
  posterImage?: string;
  webPosterImage?: string;
}

const {
  title = "Design and Fabrication of Low-Temperature Continuous-Flow Cryostat System",
  conference = "Group Project Jury 2026 • USTH AMSN Department",
  authors = ["Nguyen Xuan Tai", "Nguyen Tien Dat", "Tran Phan Sang", "Nguyen Minh Tam"],
  affiliations = [
    "Dept. of Advanced Materials Science & Nanotechnology, USTH",
    "Laboratory of Applied Materials and Advanced Technology (LAMA)"
  ],
  pdfUrl = "/academic-portfolio/images/projects/cryostat/cryostat_academic_poster.pdf",
  posterImage = "/academic-portfolio/images/projects/cryostat/cryostat_academic_poster.png",
  webPosterImage = "/academic-portfolio/images/projects/cryostat/cryostat_academic_poster_web.png",
} = Astro.props;
---

<div class="academic-poster-container my-8 border border-neutral-800 bg-neutral-950/80 rounded-2xl overflow-hidden shadow-2xl backdrop-blur-sm">
  <!-- Top Control Bar -->
  <div class="px-5 py-3.5 bg-neutral-900/90 border-b border-neutral-800/80 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold tracking-wider uppercase bg-amber-500/10 text-amber-400 border border-amber-500/20">
        Academic Poster
      </span>
      <span class="text-xs text-neutral-400 font-sans truncate max-w-xs sm:max-w-md">
        {conference}
      </span>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="btn-open-poster-modal"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-neutral-200 bg-neutral-800/90 hover:bg-neutral-700 hover:text-white transition cursor-pointer border border-neutral-700/60"
        title="View Fullscreen High-Resolution"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0 0l-5-5m-7 11l-5 5m0 0h4m-4 0v-4m16 4v-4m0 4h-4m4 0l-5-5"/>
        </svg>
        Fullscreen
      </button>

      {pdfUrl && (
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-medium text-white bg-blue-600 hover:bg-blue-500 transition shadow-sm"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Download PDF
        </a>
      )}
    </div>
  </div>

  <!-- Interactive Poster Preview Frame -->
  <div
    class="relative bg-neutral-900/60 flex justify-center items-center overflow-hidden p-3 group cursor-zoom-in min-h-[380px]"
    id="poster-preview-card"
  >
    <img
      src={webPosterImage}
      alt={title}
      class="w-full h-auto max-h-[700px] object-contain rounded-lg shadow-xl transition-transform duration-300 group-hover:scale-[1.01]"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-neutral-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center pointer-events-none">
      <span class="px-4 py-2 rounded-full bg-neutral-900/90 text-white text-xs font-mono tracking-wide border border-neutral-700/80 shadow-lg flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
        </svg>
        Click to Inspect Full-Resolution Poster
      </span>
    </div>
  </div>

  <!-- Metadata Summary -->
  <div class="px-5 py-3.5 bg-neutral-950/90 border-t border-neutral-800/80 text-xs text-neutral-400 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
    <div>
      <span class="text-neutral-200 font-semibold">{authors.join(", ")}</span>
      <p class="text-neutral-500 text-[11px] mt-0.5">{affiliations.join(" • ")}</p>
    </div>
    <div class="text-right font-mono text-[11px] text-neutral-500">
      ISO A0 Landscape • 1189 × 841 mm
    </div>
  </div>
</div>

<!-- Fullscreen Inspection Modal -->
<dialog
  id="poster-modal-dialog"
  class="backdrop:bg-black/90 backdrop:backdrop-blur-md bg-transparent p-0 m-auto max-w-[96vw] max-h-[96vh] rounded-2xl outline-none overflow-hidden"
>
  <div class="relative bg-neutral-950 border border-neutral-800 rounded-2xl flex flex-col max-h-[94vh] shadow-2xl">
    <div class="flex items-center justify-between px-5 py-3 bg-neutral-900 border-b border-neutral-800">
      <div class="flex items-center gap-2 truncate pr-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <h4 class="text-sm font-medium text-neutral-200 truncate">{title}</h4>
      </div>
      <div class="flex items-center gap-2">
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-neutral-300 hover:text-white px-2.5 py-1 rounded bg-neutral-800 hover:bg-neutral-700 transition"
        >
          Direct PDF
        </a>
        <button
          id="btn-close-poster-modal"
          class="text-neutral-400 hover:text-white p-1 rounded hover:bg-neutral-800 transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
    <div class="overflow-auto p-4 flex justify-center items-center bg-neutral-950/90">
      <img
        src={posterImage}
        alt={title}
        class="max-w-full max-h-[84vh] object-contain rounded-lg shadow-2xl"
      />
    </div>
  </div>
</dialog>

<script>
  function setupPosterModal() {
    const openBtn = document.getElementById("btn-open-poster-modal");
    const closeBtn = document.getElementById("btn-close-poster-modal");
    const cardWrapper = document.getElementById("poster-preview-card");
    const modal = document.getElementById("poster-modal-dialog") as HTMLDialogElement | null;

    if (modal) {
      const show = () => modal.showModal();
      const hide = () => modal.close();

      openBtn?.addEventListener("click", show);
      cardWrapper?.addEventListener("click", show);
      closeBtn?.addEventListener("click", hide);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) hide();
      });
    }
  }

  // Setup on page load and view transitions
  setupPosterModal();
  document.addEventListener("astro:page-load", setupPosterModal);
</script>
