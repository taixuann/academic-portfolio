---
/**
 * AcademicPosterViewer.astro
 * Direct academic poster embed without modal layers or redundant wrappers.
 */
interface Props {
  title?: string;
  pdfUrl?: string;
  posterImage?: string;
}

const {
  title = "Design and Fabrication of Low-Temperature Continuous-Flow Cryostat System",
  pdfUrl = "/academic-portfolio/images/projects/cryostat/cryostat_academic_poster.pdf",
  posterImage = "/academic-portfolio/images/projects/cryostat/cryostat_academic_poster_web.png",
} = Astro.props;
---

<figure class="my-6">
  <a
    href={pdfUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="block group cursor-pointer"
    title="Open full-resolution vector PDF in new tab"
  >
    <img
      src={posterImage}
      alt={title}
      class="w-full h-auto rounded-lg border border-neutral-800 shadow-md transition hover:border-neutral-600"
      loading="eager"
    />
  </a>
  <figcaption class="mt-2.5 flex flex-wrap items-center justify-between text-xs text-neutral-400 gap-2">
    <span>USTH AMSN • Continuous-Flow Cryostat Research Poster (ISO A0 Landscape)</span>
    <a
      href={pdfUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 font-medium text-blue-400 hover:text-blue-300 transition"
    >
      <span>Open Full-Resolution PDF</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
    </a>
  </figcaption>
</figure>
