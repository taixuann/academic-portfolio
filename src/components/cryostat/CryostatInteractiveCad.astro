---
// CryostatInteractiveCad.astro
// Interactive CAD Subassembly Explorer & Technical Blueprint for 80 K Cryostat System
---

<div class="cryo-cad-container" id="cryo-cad-app">
    <!-- Header Control Toolbar -->
    <div class="cryo-toolbar">
        <div class="toolbar-section">
            <span class="toolbar-label">VIEW MODE</span>
            <div class="btn-group" role="group">
                <button type="button" class="cryo-btn active" data-view="assembly">
                    <span class="indicator"></span> Assembly
                </button>
                <button type="button" class="cryo-btn" data-view="exploded">
                    <span class="indicator"></span> Exploded
                </button>
                <button type="button" class="cryo-btn" data-view="thermal">
                    <span class="indicator"></span> Thermal 80 K
                </button>
            </div>
        </div>

        <div class="toolbar-section" id="thermal-controls" style="display: none;">
            <span class="toolbar-label">TEMPERATURE SIMULATION</span>
            <div class="slider-wrapper">
                <span class="temp-readout" id="temp-display">300 K</span>
                <input type="range" id="temp-slider" min="77" max="300" value="300" class="temp-range" />
                <span class="stage-tag" id="stage-status">Ambient Equilibrium</span>
            </div>
        </div>

        <div class="toolbar-section">
            <span class="toolbar-label">MATERIAL FILTER</span>
            <div class="btn-group" role="group">
                <button type="button" class="mat-filter-btn active" data-mat="all">All</button>
                <button type="button" class="mat-filter-btn" data-mat="cu">Cu-OFHC</button>
                <button type="button" class="mat-filter-btn" data-mat="ss">SUS304</button>
                <button type="button" class="mat-filter-btn" data-mat="gold">Au / Elect</button>
            </div>
        </div>
    </div>

    <!-- Main CAD Blueprint Canvas -->
    <div class="cryo-canvas-card">
        <svg viewBox="0 0 1000 700" class="cryo-blueprint-svg" id="cryo-svg" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <!-- Material Hatching Pattern (SUS304 Stainless Steel) -->
                <pattern id="hatch-ss" width="8" height="8" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
                    <line x1="0" y1="0" x2="0" y2="8" stroke="currentColor" stroke-width="0.8" opacity="0.35" />
                </pattern>
                
                <!-- Dynamic Thermal Gradient for Cold Finger -->
                <linearGradient id="thermal-grad-col" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" id="grad-top" stop-color="#f59e0b" stop-opacity="0.9" />
                    <stop offset="60%" id="grad-mid" stop-color="#f59e0b" stop-opacity="0.85" />
                    <stop offset="100%" id="grad-bot" stop-color="#d97706" stop-opacity="0.95" />
                </linearGradient>

                <!-- Dynamic Thermal Gradient for Sample Holder -->
                <linearGradient id="thermal-grad-holder" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" id="grad-holder-1" stop-color="#f59e0b" stop-opacity="0.95" />
                    <stop offset="100%" id="grad-holder-2" stop-color="#b45309" stop-opacity="0.9" />
                </linearGradient>

                <!-- Dimension Arrows -->
                <marker id="dim-arrow-start" viewBox="0 0 10 10" refX="0" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                    <path d="M 10 0 L 0 5 L 10 10 z" fill="currentColor" />
                </marker>
                <marker id="dim-arrow-end" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
                </marker>

                <!-- Heat Flow Vectors Animation -->
                <pattern id="heat-arrows" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M 10 2 L 10 16 M 6 12 L 10 16 L 14 12" stroke="#00f0ff" stroke-width="1.5" fill="none" opacity="0.8" />
                </pattern>
            </defs>

            <!-- Technical Drawing Grid & Frame -->
            <rect x="15" y="15" width="970" height="670" fill="none" stroke="currentColor" stroke-width="1.5" class="grid-border" />
            <rect x="20" y="20" width="960" height="660" fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="4 4" class="grid-border-sub" />

            <!-- Symmetry Centerlines -->
            <line x1="500" y1="25" x2="500" y2="675" stroke="currentColor" stroke-width="0.6" stroke-dasharray="14 3 3 3" class="center-line" />
            <line x1="25" y1="350" x2="975" y2="350" stroke="currentColor" stroke-width="0.6" stroke-dasharray="14 3 3 3" class="center-line" />

            <!-- ======================================================== -->
            <!-- SUBASSEMBLY 5: DEWAR VESSEL & MLI JACKET (BOTTOM BACKDROP)-->
            <!-- ======================================================== -->
            <g id="sub-dewar" class="cad-subassembly" data-part="dewar">
                <!-- Outer Dewar Tank (384mm OD, 600mm Height) -->
                <path d="M 330 200 L 330 630 A 20 20 0 0 0 350 650 L 650 650 A 20 20 0 0 0 670 630 L 670 200" 
                      fill="none" stroke="currentColor" stroke-width="1.5" class="mat-ss dewar-body" />
                <!-- MLI Superinsulation Layers -->
                <path d="M 345 220 L 345 615 A 15 15 0 0 0 360 630 L 640 630 A 15 15 0 0 0 655 615 L 655 220" 
                      fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="6 2" class="mat-mli" />
                <!-- Liquid Nitrogen Level Indicator -->
                <rect x="350" y="450" width="300" height="175" fill="currentColor" class="ln2-liquid" opacity="0.08" />
                <line x1="350" y1="450" x2="650" y2="450" stroke="#38bdf8" stroke-width="1.2" stroke-dasharray="8 3" />
                <text x="360" y="442" font-size="10" font-family="monospace" fill="#38bdf8">LN2 POOL LEVEL (77.4 K)</text>
            </g>

            <!-- ======================================================== -->
            <!-- SUBASSEMBLY 3: DEMOUNTABLE VACUUM CHAMBER & SHROUD      -->
            <!-- ======================================================== -->
            <g id="sub-chamber" class="cad-subassembly part-anim" data-part="chamber">
                <!-- Vacuum Shroud Tube (114mm OD, 3mm Wall) -->
                <rect x="440" y="160" width="120" height="380" fill="none" stroke="currentColor" stroke-width="1.5" class="mat-ss chamber-wall" />
                <!-- Chamber Hatching (Cutaway Section A-A) -->
                <rect x="440" y="160" width="8" height="380" fill="url(#hatch-ss)" stroke="currentColor" stroke-width="0.8" class="mat-ss" />
                <rect x="552" y="160" width="8" height="380" fill="url(#hatch-ss)" stroke="currentColor" stroke-width="0.8" class="mat-ss" />
                <!-- Lower Demountable Flange Ring -->
                <rect x="430" y="150" width="140" height="12" fill="none" stroke="currentColor" stroke-width="1.5" class="mat-ss" />
                <circle cx="438" cy="156" r="3" fill="none" stroke="currentColor" stroke-width="0.8" />
                <circle cx="562" cy="156" r="3" fill="none" stroke="currentColor" stroke-width="0.8" />
                <!-- Bottom End Cap -->
                <rect x="435" y="540" width="130" height="10" rx="3" fill="none" stroke="currentColor" stroke-width="1.5" class="mat-ss" />
                <!-- Vacuum Chamber Label -->
                <text x="452" y="525" font-size="10" font-family="monospace" class="cad-label mat-ss">VACUUM SHROUD (SUS304)</text>
            </g>

            <!-- ======================================================== -->
            <!-- SUBASSEMBLY 2: CENTRAL COLD FINGER & THERMAL LINK COLUMN -->
            <!-- ======================================================== -->
            <g id="sub-column" class="cad-subassembly part-anim" data-part="column">
                <!-- Solid OFHC Copper Rod (20mm Dia) -->
                <rect x="490" y="120" width="20" height="400" rx="2" fill="url(#thermal-grad-col)" stroke="currentColor" stroke-width="1.5" class="mat-cu copper-rod" />
                
                <!-- Radiation Baffles (Cu Discs to block 300K thermal radiation down neck) -->
                <rect x="450" y="220" width="100" height="4" fill="url(#thermal-grad-col)" stroke="currentColor" stroke-width="1" class="mat-cu" />
                <rect x="450" y="270" width="100" height="4" fill="url(#thermal-grad-col)" stroke="currentColor" stroke-width="1" class="mat-cu" />
                <rect x="450" y="320" width="100" height="4" fill="url(#thermal-grad-col)" stroke="currentColor" stroke-width="1" class="mat-cu" />
                
                <!-- Thermal Anchor Bobbin for 36-AWG Wire Heat-Sinking -->
                <rect x="475" y="360" width="50" height="24" rx="2" fill="url(#thermal-grad-col)" stroke="currentColor" stroke-width="1.2" class="mat-cu" />
                <!-- Wrapped Heat Sink Wiring -->
                <path d="M 477 365 L 523 365 M 477 372 L 523 372 M 477 379 L 523 379" stroke="#d97706" stroke-width="1.2" />

                <!-- Dynamic Heat Flux Vectors Overlay (Hidden until thermal mode) -->
                <g class="heat-flux-arrows" opacity="0">
                    <line x1="500" y1="160" x2="500" y2="480" stroke="#00f0ff" stroke-width="2" stroke-dasharray="8 6" marker-end="url(#dim-arrow-end)" />
                    <text x="508" y="250" font-size="9" font-family="monospace" fill="#00f0ff">HEAT FLUX q⃗</text>
                </g>
            </g>

            <!-- ======================================================== -->
            <!-- SUBASSEMBLY 1: TOP FLANGE & FEEDTHROUGH SUBSYSTEM       -->
            <!-- ======================================================== -->
            <g id="sub-feedthrough" class="cad-subassembly part-anim" data-part="feedthrough">
                <!-- Top Flange Plate (130mm Dia, 10mm Thick) -->
                <rect x="420" y="110" width="160" height="15" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" class="mat-ss" />
                <!-- Flange Bolt Holes -->
                <circle cx="430" cy="117" r="3.5" fill="none" stroke="currentColor" stroke-width="0.8" />
                <circle cx="570" cy="117" r="3.5" fill="none" stroke="currentColor" stroke-width="0.8" />

                <!-- Hermetic DB-25 Feedthrough Port -->
                <rect x="470" y="60" width="60" height="50" fill="none" stroke="currentColor" stroke-width="1.5" class="mat-ss" />
                <!-- DB-25 Connector Shell & Gold Pins -->
                <rect x="478" y="45" width="44" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.2" class="mat-gold" />
                <path d="M 483 50 L 483 56 M 488 50 L 488 56 M 493 50 L 493 56 M 498 50 L 498 56 M 503 50 L 503 56 M 508 50 L 508 56 M 513 50 L 513 56" stroke="#fbbf24" stroke-width="1.5" class="mat-gold" />

                <!-- KF-25 Vacuum Pumping Port (Left Arm) -->
                <path d="M 450 110 L 450 75 L 430 75 L 430 65 L 460 65 L 460 110" fill="none" stroke="currentColor" stroke-width="1.2" class="mat-ss" />
                <line x1="425" y1="65" x2="465" y2="65" stroke="currentColor" stroke-width="2" class="mat-ss" />

                <!-- Pirani Gauge Coupling & Helium Port (Right Arm) -->
                <path d="M 540 110 L 540 80 L 565 80 L 565 70 L 530 70 L 530 110" fill="none" stroke="currentColor" stroke-width="1.2" class="mat-ss" />
                <line x1="525" y1="70" x2="570" y2="70" stroke="currentColor" stroke-width="2" class="mat-ss" />

                <!-- Feedthrough Label -->
                <text x="445" y="35" font-size="10" font-family="monospace" class="cad-label mat-gold">HERMETIC DB-25 FEEDTHROUGH</text>
            </g>

            <!-- ======================================================== -->
            <!-- SUBASSEMBLY 4: CU SAMPLE STAGE & SENSOR SUBSYSTEM        -->
            <!-- ======================================================== -->
            <g id="sub-sample-holder" class="cad-subassembly part-anim" data-part="sample-holder">
                <!-- OFHC Copper Base Block (40 x 50 x 30 mm) -->
                <rect x="475" y="415" width="50" height="60" rx="2" fill="url(#thermal-grad-holder)" stroke="currentColor" stroke-width="1.5" class="mat-cu holder-block" />
                
                <!-- Internal Pt100 RTD Sensor Pocket -->
                <rect x="480" y="455" width="12" height="16" rx="1" fill="none" stroke="#38bdf8" stroke-width="1.2" stroke-dasharray="2 2" />
                <circle cx="486" cy="463" r="2.5" fill="#38bdf8" />
                <text x="440" y="466" font-size="8" font-family="monospace" fill="#38bdf8">Pt100</text>

                <!-- Internal 50W Cartridge Heater Slot -->
                <rect x="508" y="450" width="12" height="22" rx="1" fill="none" stroke="#ef4444" stroke-width="1.2" stroke-dasharray="2 2" />
                <line x1="514" y1="452" x2="514" y2="470" stroke="#ef4444" stroke-width="1.5" />
                <text x="525" y="466" font-size="8" font-family="monospace" fill="#ef4444">HEATER</text>

                <!-- Cryogenic Sample PCB Carrier (Green FR-4) -->
                <rect x="465" y="420" width="70" height="24" rx="1" fill="#064e3b" stroke="#10b981" stroke-width="1.2" class="mat-pcb" />
                <!-- Gold Contact Fingers & Pads -->
                <rect x="470" y="423" width="8" height="18" fill="#fbbf24" class="mat-gold" />
                <rect x="522" y="423" width="8" height="18" fill="#fbbf24" class="mat-gold" />
                
                <!-- Silicon Device Chip (10x10 mm) in center -->
                <rect x="490" y="425" width="20" height="14" fill="#1e293b" stroke="#94a3b8" stroke-width="1" />
                <!-- Z-Spring Beryllium-Copper Probes -->
                <path d="M 478 430 L 490 430 M 510 430 L 522 430" stroke="#fbbf24" stroke-width="1.2" />

                <!-- Sample Stage Label -->
                <text x="540" y="435" font-size="9" font-family="monospace" class="cad-label mat-cu">CU STAGE</text>
            </g>

            <!-- ======================================================== -->
            <!-- DIMENSIONS & LEADER LINES                                -->
            <!-- ======================================================== -->
            <g id="dimension-layer" class="dimension-lines" opacity="0.75">
                <!-- Dewar Diameter (384mm) -->
                <line x1="330" y1="660" x2="670" y2="660" stroke="currentColor" stroke-width="0.7" marker-start="url(#dim-arrow-start)" marker-end="url(#dim-arrow-end)" />
                <text x="475" y="656" font-size="9" font-family="monospace" fill="currentColor">⌀ 384 mm</text>

                <!-- Chamber Outer Diameter (114mm) -->
                <line x1="440" y1="565" x2="560" y2="565" stroke="currentColor" stroke-width="0.7" marker-start="url(#dim-arrow-start)" marker-end="url(#dim-arrow-end)" />
                <text x="480" y="561" font-size="8" font-family="monospace" fill="currentColor">⌀ 114 mm</text>

                <!-- Height Reference (600mm) -->
                <line x1="310" y1="120" x2="310" y2="650" stroke="currentColor" stroke-width="0.7" marker-start="url(#dim-arrow-start)" marker-end="url(#dim-arrow-end)" />
                <text x="260" y="380" font-size="9" font-family="monospace" fill="currentColor" transform="rotate(-90 260 380)">L = 600 mm</text>
            </g>

            <!-- ======================================================== -->
            <!-- ISO TITLE BLOCK / METADATA BOX (BOTTOM RIGHT)            -->
            <!-- ======================================================== -->
            <g class="title-block" font-family="monospace" font-size="9">
                <rect x="680" y="580" width="295" height="95" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="1" />
                <line x1="680" y1="605" x2="975" y2="605" stroke="currentColor" stroke-width="0.6" />
                <line x1="680" y1="630" x2="975" y2="630" stroke="currentColor" stroke-width="0.6" />
                <line x1="680" y1="655" x2="975" y2="655" stroke="currentColor" stroke-width="0.6" />
                <line x1="840" y1="605" x2="840" y2="675" stroke="currentColor" stroke-width="0.6" />

                <text x="690" y="598" font-weight="bold" font-size="10">DWG: USTH-CRYO-V9.16-EXP</text>
                <text x="690" y="620">SYSTEM: MODULAR 80 K CRYOSTAT</text>
                <text x="850" y="620">REV: 03.2</text>
                <text x="690" y="645">ENGINEER: NGUYEN XUAN TAI</text>
                <text x="850" y="645">SCALE: 1:3</text>
                <text x="690" y="668">MAT: Cu-OFHC / SUS304 / FR-4</text>
                <text x="850" y="668">UNITS: MM</text>
            </g>
        </svg>
    </div>

    <!-- Telemetry & Subassembly Inspector Card -->
    <div class="cryo-inspector-card" id="inspector-panel">
        <div class="inspector-header">
            <span class="inspector-badge" id="part-mat-badge">SYSTEM OVERVIEW</span>
            <h3 class="inspector-title" id="part-title">Cryostat Assembly (Section A-A)</h3>
        </div>
        <div class="inspector-grid">
            <div class="inspector-item">
                <span class="item-label">Primary Material</span>
                <span class="item-val" id="part-material">Cu-OFHC (99.99%) & SUS304</span>
            </div>
            <div class="inspector-item">
                <span class="item-label">Thermal Conductivity (k)</span>
                <span class="item-val" id="part-thermal">~401 W/m·K (300K) → 1200 W/m·K (80K)</span>
            </div>
            <div class="inspector-item">
                <span class="item-label">Operating Vacuum</span>
                <span class="item-val" id="part-vacuum">1.5 × 10⁻⁵ mbar (Turbomolecular Base)</span>
            </div>
            <div class="inspector-item">
                <span class="item-label">Mechanical Architecture</span>
                <span class="item-val" id="part-role">Demountable shroud with central thermal column and hermetic feedthrough.</span>
            </div>
        </div>
        <p class="inspector-desc" id="part-desc">
            Hover over or click on any subassembly (Top Feedthrough, Central Column, Vacuum Chamber, or Cu Sample Stage) to inspect separated engineering materials, thermal anchoring, and dimensional tolerances.
        </p>
    </div>
</div>

<style>
/* Scoped Component Styles */
.cryo-cad-container {
    width: 100%;
    margin: 2rem 0;
    border: 1px solid var(--line, #334155);
    background: var(--bg-card, #0f172a);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--ink, #f8fafc);
}

.cryo-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    background: rgba(15, 23, 42, 0.75);
    border-bottom: 1px solid var(--line, #334155);
}

.toolbar-section {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.toolbar-label {
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--ink-3, #94a3b8);
}

.btn-group {
    display: flex;
    gap: 0.25rem;
    background: rgba(30, 41, 59, 0.8);
    padding: 0.25rem;
    border-radius: 6px;
    border: 1px solid rgba(148, 163, 184, 0.15);
}

.cryo-btn, .mat-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: var(--ink-2, #cbd5e1);
    cursor: pointer;
    transition: all 0.2s ease;
}

.cryo-btn .indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #64748b;
    transition: background 0.2s ease;
}

.cryo-btn:hover, .mat-filter-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
}

.cryo-btn.active {
    background: #2563eb;
    color: #ffffff;
}

.cryo-btn.active .indicator {
    background: #60a5fa;
    box-shadow: 0 0 8px #60a5fa;
}

.mat-filter-btn.active {
    background: rgba(56, 189, 248, 0.18);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.4);
}

.slider-wrapper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.temp-readout {
    font-family: ui-monospace, monospace;
    font-weight: 700;
    font-size: 0.85rem;
    color: #38bdf8;
    min-width: 48px;
}

.temp-range {
    cursor: pointer;
    accent-color: #38bdf8;
    width: 110px;
}

.stage-tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    font-family: ui-monospace, monospace;
}

/* Canvas Area */
.cryo-canvas-card {
    position: relative;
    width: 100%;
    padding: 1rem;
    background: #090d16;
    display: flex;
    justify-content: center;
}

.cryo-blueprint-svg {
    width: 100%;
    height: auto;
    max-height: 680px;
}

/* SVG Interactive Element Styling */
.cad-subassembly {
    cursor: pointer;
    transition: opacity 0.3s ease, filter 0.3s ease;
}

.cad-subassembly:hover {
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.7));
}

.cad-subassembly.dimmed {
    opacity: 0.18 !important;
}

.cad-subassembly.selected {
    filter: drop-shadow(0 0 10px rgba(0, 240, 255, 0.9));
}

/* Part Animation Transforms for Exploded View */
.part-anim {
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
}

/* Material Accent Classes */
.mat-ss {
    color: #94a3b8;
}
.mat-cu {
    color: #f59e0b;
}
.mat-gold {
    color: #fbbf24;
}
.mat-pcb {
    color: #10b981;
}

/* Exploded State Displacements */
[data-state-view="exploded"] #sub-feedthrough {
    transform: translateY(-55px);
}
[data-state-view="exploded"] #sub-chamber {
    transform: translateY(110px);
}
[data-state-view="exploded"] #sub-sample-holder {
    transform: translate(60px, 30px);
}
[data-state-view="exploded"] #sub-column {
    transform: translateY(-10px);
}
[data-state-view="exploded"] #sub-dewar {
    transform: translateY(130px);
    opacity: 0.35;
}

/* Inspector Card */
.cryo-inspector-card {
    padding: 1.25rem 1.5rem;
    background: rgba(15, 23, 42, 0.95);
    border-top: 1px solid var(--line, #334155);
}

.inspector-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
}

.inspector-badge {
    font-size: 0.65rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(37, 99, 235, 0.2);
    color: #60a5fa;
    border: 1px solid rgba(37, 99, 235, 0.4);
}

.inspector-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: #ffffff;
}

.inspector-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 0.85rem;
    padding: 0.85rem;
    background: rgba(30, 41, 59, 0.4);
    border-radius: 6px;
    border: 1px solid rgba(148, 163, 184, 0.1);
}

.inspector-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.item-label {
    font-size: 0.7rem;
    font-family: ui-monospace, monospace;
    color: #94a3b8;
    text-transform: uppercase;
}

.item-val {
    font-size: 0.85rem;
    font-weight: 500;
    color: #e2e8f0;
}

.inspector-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #94a3b8;
}
</style>

<script>
// Client-side interactivity script
document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("cryo-cad-app");
    if (!container) return;

    const viewBtns = container.querySelectorAll(".cryo-btn");
    const matBtns = container.querySelectorAll(".mat-filter-btn");
    const subassemblies = container.querySelectorAll(".cad-subassembly");
    const thermalControls = document.getElementById("thermal-controls");
    const tempSlider = document.getElementById("temp-slider");
    const tempDisplay = document.getElementById("temp-display");
    const stageStatus = document.getElementById("stage-status");
    const heatFluxArrows = container.querySelector(".heat-flux-arrows");

    // Dynamic gradient elements
    const gradTop = document.getElementById("grad-top");
    const gradMid = document.getElementById("grad-mid");
    const gradBot = document.getElementById("grad-bot");
    const gradHolder1 = document.getElementById("grad-holder-1");
    const gradHolder2 = document.getElementById("grad-holder-2");

    // Inspector Elements
    const badgeEl = document.getElementById("part-mat-badge");
    const titleEl = document.getElementById("part-title");
    const matEl = document.getElementById("part-material");
    const thermalEl = document.getElementById("part-thermal");
    const vacuumEl = document.getElementById("part-vacuum");
    const roleEl = document.getElementById("part-role");
    const descEl = document.getElementById("part-desc");

    // Part Metadata Database
    const partData = {
        feedthrough: {
            badge: "SUBASSEMBLY 01 | SUS304 & GOLD",
            title: "Hermetic DB-25 Feedthrough & Top Flange",
            material: "AISI 304 Stainless Steel & Gold-Plated BeCu Pins",
            thermal: "Thermal Isolation Neck (Thin Wall SS304 reduces parasitic conduction)",
            vacuum: "Hermetic Glass-Ceramic Seal (< 1 × 10⁻⁹ mbar·L/s He leak rate)",
            role: "Directly anchors onto the central column; couples 24 multi-terminal electrical signal channels to Keithley SMU.",
            desc: "Custom top flange assembly featuring KF-25 roughing/turbopump port, Pirani gauge coupling, and an airtight 25-pin D-sub feedthrough. Anchors directly onto the structural support column."
        },
        column: {
            badge: "SUBASSEMBLY 02 | OFHC COPPER",
            title: "Central Cold Finger & Radiation Baffle Column",
            material: "OFHC Copper (ASTM B170, 99.99% Cu) - Solid ⌀ 20 mm",
            thermal: "High Thermal Conductance: k = 401 W/m·K (300K) → 1200+ W/m·K (80K)",
            vacuum: "High-vacuum compatible, electropolished surface",
            role: "Primary thermal highway transporting cryogenic cooling power from LN2 bath to the sample stage.",
            desc: "Solid 20 mm oxygen-free high-conductivity copper rod. Equipped with 3 circular radiation baffles to shield against 300 K blackbody radiation, and an anchor bobbin for wire thermal anchoring."
        },
        chamber: {
            badge: "SUBASSEMBLY 03 | SUS304 STAINLESS",
            title: "Demountable Vacuum Chamber & Outer Shroud",
            material: "AISI 304 Stainless Steel (⌀ 114 mm OD, 3 mm Wall)",
            thermal: "Dewar Vacuum Jacket (prevents convective heat leakage from ambient air)",
            vacuum: "Viton O-Ring / Knife-Edge Demountable Flange Joint",
            role: "Maintains high vacuum isolation (< 2 × 10⁻⁵ mbar) to minimize residual gas conduction.",
            desc: "Precision cylindrical shroud separating inner cryogenic parts from ambient atmospheric convection. Can be unbolted and slid downward to reveal the inner sample stage."
        },
        "sample-holder": {
            badge: "SUBASSEMBLY 04 | COPPER / PCB / PT100",
            title: "Cryogenic Sample Stage & Modular Carrier",
            material: "Cu-OFHC Block (40 × 50 × 30 mm) + FR-4 PCB with Au Fingers",
            thermal: "Fast Thermal Relaxation (Time constant τ < 180s to reach equilibrium)",
            vacuum: "Apiezon N Cryogenic Thermal Grease thermal contact",
            role: "Mounts semiconductor/memristor chip with spring-loaded Z-spring pins; hosts Pt100 sensor and 50W cartridge heater.",
            desc: "High-mass OFHC copper block with direct mechanical contact to cold finger. Features embedded Pt100 RTD sensor, 50W heating cartridge for PID temperature sweeps (77K–350K), and modular PCB."
        },
        dewar: {
            badge: "SUBASSEMBLY 05 | CRYOGEN DEWAR",
            title: "Liquid Nitrogen Dewar & Superinsulation Jacket",
            material: "Double-Walled SUS304 with Aluminized Mylar MLI (30 Layers)",
            thermal: "Boil-off rate < 0.45 L/hr under operating vacuum",
            vacuum: "Pervacuum Space < 10⁻⁴ mbar",
            role: "Cryogen reservoir maintaining 77.4 K thermal ground for liquid nitrogen immersion.",
            desc: "Double-walled vacuum-insulated cryogenic storage vessel (⌀ 384 mm, H = 600 mm) housing liquid nitrogen pool."
        }
    };

    // 1. View Switching Handler
    viewBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            viewBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");

            const view = btn.getAttribute("data-view");
            container.setAttribute("data-state-view", view);

            if (view === "thermal") {
                if (thermalControls) thermalControls.style.display = "flex";
                if (heatFluxArrows) heatFluxArrows.style.opacity = "1";
                updateTemperature(tempSlider ? tempSlider.value : 80);
            } else {
                if (thermalControls) thermalControls.style.display = "none";
                if (heatFluxArrows) heatFluxArrows.style.opacity = "0";
                resetThermalGradients();
            }
        });
    });

    // 2. Material Filtering Handler
    matBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            matBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");

            const mat = btn.getAttribute("data-mat");
            subassemblies.forEach(sub => {
                if (mat === "all") {
                    sub.classList.remove("dimmed");
                } else if (mat === "cu") {
                    sub.classList.toggle("dimmed", !["column", "sample-holder"].includes(sub.getAttribute("data-part")));
                } else if (mat === "ss") {
                    sub.classList.toggle("dimmed", !["feedthrough", "chamber", "dewar"].includes(sub.getAttribute("data-part")));
                } else if (mat === "gold") {
                    sub.classList.toggle("dimmed", !["feedthrough", "sample-holder"].includes(sub.getAttribute("data-part")));
                }
            });
        });
    });

    // 3. Subassembly Click & Hover Inspector
    subassemblies.forEach(sub => {
        sub.addEventListener("mouseenter", () => {
            const partKey = sub.getAttribute("data-part");
            updateInspector(partKey);
        });

        sub.addEventListener("click", () => {
            subassemblies.forEach(s => s.classList.remove("selected"));
            sub.classList.add("selected");
            const partKey = sub.getAttribute("data-part");
            updateInspector(partKey);
        });
    });

    function updateInspector(partKey) {
        const data = partData[partKey];
        if (!data) return;

        badgeEl.textContent = data.badge;
        titleEl.textContent = data.title;
        matEl.textContent = data.material;
        thermalEl.textContent = data.thermal;
        vacuumEl.textContent = data.vacuum;
        roleEl.textContent = data.role;
        descEl.textContent = data.desc;
    }

    // 4. Dynamic Temperature Cooldown Simulation
    if (tempSlider) {
        tempSlider.addEventListener("input", (e) => {
            updateTemperature(e.target.value);
        });
    }

    function updateTemperature(kelvin) {
        const k = parseInt(kelvin);
        tempDisplay.textContent = `${k} K`;

        // Update status pill
        if (k > 250) {
            stageStatus.textContent = "Ambient Regime";
            stageStatus.style.color = "#f59e0b";
            stageStatus.style.background = "rgba(245, 158, 11, 0.15)";
        } else if (k > 120) {
            stageStatus.textContent = "Active Cooldown";
            stageStatus.style.color = "#38bdf8";
            stageStatus.style.background = "rgba(56, 189, 248, 0.15)";
        } else {
            stageStatus.textContent = "Cryogenic Saturation (80 K)";
            stageStatus.style.color = "#00f0ff";
            stageStatus.style.background = "rgba(0, 240, 255, 0.2)";
        }

        // Interpolate colors between 300K (Warm Amber) and 77K (Deep Cyan/Blue)
        const factor = (300 - k) / (300 - 77); // 0 at 300K, 1 at 77K
        
        // Colors
        const r = Math.round(245 - factor * 245);
        const g = Math.round(158 + factor * 50);
        const b = Math.round(11 + factor * 240);
        const colorHex = `rgb(${r}, ${g}, ${b})`;
        const coldBlue = `rgb(0, ${Math.round(180 + factor * 60)}, 255)`;

        if (gradTop) gradTop.setAttribute("stop-color", k > 200 ? "#f59e0b" : "#0284c7");
        if (gradMid) gradMid.setAttribute("stop-color", colorHex);
        if (gradBot) gradBot.setAttribute("stop-color", coldBlue);
        if (gradHolder1) gradHolder1.setAttribute("stop-color", colorHex);
        if (gradHolder2) gradHolder2.setAttribute("stop-color", coldBlue);
    }

    function resetThermalGradients() {
        if (gradTop) gradTop.setAttribute("stop-color", "#f59e0b");
        if (gradMid) gradMid.setAttribute("stop-color", "#f59e0b");
        if (gradBot) gradBot.setAttribute("stop-color", "#d97706");
        if (gradHolder1) gradHolder1.setAttribute("stop-color", "#f59e0b");
        if (gradHolder2) gradHolder2.setAttribute("stop-color", "#b45309");
    }
});
</script>
