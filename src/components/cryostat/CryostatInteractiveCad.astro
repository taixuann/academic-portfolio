---
// CryostatInteractiveCad.astro
// Precision CAD Blueprint & Interactive Subassembly Explorer
// Engineered for 80 K Low-Temperature Cryostat Platform (LAMA / USTH)
---

<div class="cryo-cad-wrapper not-prose" id="cryo-cad-app">
    <!-- Top Control Bar (Clean Segmented Toolbar, Anti-UI-Slop) -->
    <div class="cad-header-bar">
        <div class="cad-title-group">
            <span class="cad-badge">CAD ARCHITECTURE</span>
            <span class="cad-model-name">DN100 Modular 80 K Cryostat</span>
        </div>

        <!-- View Mode Segmented Control -->
        <div class="segmented-control" role="tablist">
            <button type="button" class="seg-btn active" data-view="assembly" role="tab">
                Assembly View
            </button>
            <button type="button" class="seg-btn" data-view="exploded" role="tab">
                Exploded Subsystems
            </button>
            <button type="button" class="seg-btn" data-view="thermal" role="tab">
                80 K Thermal Dynamics
            </button>
        </div>

        <!-- Material Filter Pills -->
        <div class="material-pills">
            <button type="button" class="mat-pill active" data-mat="all">All Parts</button>
            <button type="button" class="mat-pill" data-mat="cu">OFHC Copper</button>
            <button type="button" class="mat-pill" data-mat="ss">SS304L Steel</button>
        </div>
    </div>

    <!-- Interactive Thermal Simulation Bar (Appears in Thermal Mode) -->
    <div class="thermal-bar" id="thermal-bar" style="display: none;">
        <div class="thermal-status-group">
            <span class="thermal-dot" id="thermal-dot"></span>
            <span class="thermal-label" id="thermal-status-text">Cryogenic Baseline Equilibrium (80 K)</span>
        </div>
        <div class="thermal-slider-container">
            <span class="temp-readout" id="temp-display">80 K</span>
            <input type="range" id="temp-slider" min="77" max="300" value="80" class="temp-slider" />
            <span class="temp-bound">300 K</span>
        </div>
        <div class="thermal-meta">
            <span>Vacuum: <strong id="vac-display">1.5 × 10⁻⁵ mbar</strong></span>
            <span>Heater Power: <strong id="power-display">0.0 W</strong></span>
        </div>
    </div>

    <!-- Main CAD Vector Drawing Viewport -->
    <div class="cad-viewport">
        <svg viewBox="0 0 1000 640" class="cad-svg-sheet" id="cryo-svg" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <!-- Clean Mechanical Cross-Section Hatching (SS304L) -->
                <pattern id="cad-hatch-ss" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
                    <line x1="0" y1="0" x2="0" y2="6" stroke="#94a3b8" stroke-width="0.7" opacity="0.3" />
                </pattern>

                <!-- OFHC Copper Dynamic Gradient -->
                <linearGradient id="cu-thermal-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" id="grad-col-top" stop-color="#38bdf8" stop-opacity="0.9" />
                    <stop offset="60%" id="grad-col-mid" stop-color="#0284c7" stop-opacity="0.95" />
                    <stop offset="100%" id="grad-col-bot" stop-color="#0369a1" stop-opacity="1" />
                </linearGradient>

                <!-- L-Shaped Sample Holder Copper Gradient -->
                <linearGradient id="cu-holder-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" id="grad-holder-1" stop-color="#0284c7" />
                    <stop offset="100%" id="grad-holder-2" stop-color="#0369a1" />
                </linearGradient>

                <!-- Dimension Arrow Markers -->
                <marker id="arrow-start" viewBox="0 0 10 10" refX="2" refY="5" markerWidth="5" markerHeight="5" orient="auto">
                    <path d="M 8 2 L 2 5 L 8 8" fill="none" stroke="#64748b" stroke-width="1.2" />
                </marker>
                <marker id="arrow-end" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
                    <path d="M 2 2 L 8 5 L 2 8" fill="none" stroke="#64748b" stroke-width="1.2" />
                </marker>
            </defs>

            <!-- Technical Drawing Sheet Border -->
            <rect x="12" y="12" width="976" height="616" fill="none" stroke="#334155" stroke-width="1" />
            <rect x="16" y="16" width="968" height="608" fill="none" stroke="#1e293b" stroke-width="0.5" stroke-dasharray="3 3" />

            <!-- Main Symmetry Centerlines -->
            <line x1="480" y1="20" x2="480" y2="620" stroke="#0284c7" stroke-width="0.5" stroke-dasharray="14 3 3 3" opacity="0.6" />

            <!-- ======================================================== -->
            <!-- SUBSYSTEM 3: DEMOUNTABLE VACUUM JACKET (DN100 SS304L)    -->
            <!-- ======================================================== -->
            <g id="group-chamber" class="cad-group part-transition" data-id="chamber" data-mat="ss">
                <!-- Outer Vacuum Chamber Tube (114mm OD, 3mm wall) -->
                <rect x="420" y="130" width="120" height="380" fill="none" stroke="#94a3b8" stroke-width="1.2" class="stroke-ss" />
                <!-- Chamber Section Wall Thickness & Hatching -->
                <rect x="420" y="130" width="6" height="380" fill="url(#cad-hatch-ss)" stroke="#64748b" stroke-width="0.8" />
                <rect x="534" y="130" width="6" height="380" fill="url(#cad-hatch-ss)" stroke="#64748b" stroke-width="0.8" />
                <!-- Lower Flange Ring & Demountable Seal -->
                <rect x="410" y="120" width="140" height="10" fill="#1e293b" stroke="#94a3b8" stroke-width="1.2" />
                <circle cx="418" cy="125" r="2.5" fill="#0f172a" stroke="#94a3b8" stroke-width="0.8" />
                <circle cx="542" cy="125" r="2.5" fill="#0f172a" stroke="#94a3b8" stroke-width="0.8" />
                <!-- Chamber Bottom Seal Cap -->
                <path d="M 416 510 L 544 510 L 534 522 L 426 522 Z" fill="#1e293b" stroke="#94a3b8" stroke-width="1.2" />
                
                <!-- Dimension: DN100 ⌀ 114 mm -->
                <line x1="420" y1="538" x2="540" y2="538" stroke="#64748b" stroke-width="0.7" marker-start="url(#arrow-start)" marker-end="url(#arrow-end)" />
                <text x="460" y="552" font-size="8" font-family="ui-monospace, monospace" fill="#94a3b8">⌀ 114 mm</text>
            </g>

            <!-- ======================================================== -->
            <!-- SUBSYSTEM 2: CENTRAL COLD FINGER & 3 RADIATION BAFFLES   -->
            <!-- ======================================================== -->
            <g id="group-column" class="cad-group part-transition" data-id="column" data-mat="cu">
                <!-- Solid OFHC Copper Central Rod (⌀ 20 mm) -->
                <rect x="470" y="90" width="20" height="390" rx="1" fill="url(#cu-thermal-gradient)" stroke="#f59e0b" stroke-width="1.2" class="cu-rod-element" />

                <!-- 3 Copper Radiation Baffles (intercept room temp radiation down the neck) -->
                <g class="baffles-group">
                    <rect x="430" y="190" width="100" height="3" rx="0.5" fill="url(#cu-thermal-gradient)" stroke="#f59e0b" stroke-width="0.8" />
                    <text x="535" y="193" font-size="7.5" font-family="ui-monospace, monospace" fill="#f59e0b">Baffle 1</text>

                    <rect x="430" y="240" width="100" height="3" rx="0.5" fill="url(#cu-thermal-gradient)" stroke="#f59e0b" stroke-width="0.8" />
                    <text x="535" y="243" font-size="7.5" font-family="ui-monospace, monospace" fill="#f59e0b">Baffle 2</text>

                    <rect x="430" y="290" width="100" height="3" rx="0.5" fill="url(#cu-thermal-gradient)" stroke="#f59e0b" stroke-width="0.8" />
                    <text x="535" y="293" font-size="7.5" font-family="ui-monospace, monospace" fill="#f59e0b">Baffle 3</text>
                </g>

                <!-- Thermal Anchor Bobbin (Heat-sinking 36-AWG Phosphor-Bronze Wires) -->
                <rect x="456" y="340" width="48" height="20" rx="1.5" fill="url(#cu-thermal-gradient)" stroke="#d97706" stroke-width="1" />
                <line x1="458" y1="345" x2="502" y2="345" stroke="#f59e0b" stroke-width="0.8" />
                <line x1="458" y1="350" x2="502" y2="350" stroke="#f59e0b" stroke-width="0.8" />
                <line x1="458" y1="355" x2="502" y2="355" stroke="#f59e0b" stroke-width="0.8" />
                <text x="510" y="354" font-size="7.5" font-family="ui-monospace, monospace" fill="#d97706">Anchor Bobbin</text>

                <!-- Heat Flux Vector Indicators (Shown in Thermal Mode) -->
                <g class="flux-arrows" id="flux-arrows" opacity="0">
                    <line x1="480" y1="120" x2="480" y2="460" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#arrow-end)" />
                    <text x="490" y="220" font-size="8" font-family="ui-monospace, monospace" fill="#38bdf8">q⃗ (Conductive Heat Flux)</text>
                </g>
            </g>

            <!-- ======================================================== -->
            <!-- SUBSYSTEM 1: TOP FLANGE & HERMETIC DB-25 FEEDTHROUGH    -->
            <!-- ======================================================== -->
            <g id="group-feedthrough" class="cad-group part-transition" data-id="feedthrough" data-mat="ss">
                <!-- Top Flange Plate (⌀ 130 mm, 10 mm thick) -->
                <rect x="400" y="80" width="160" height="12" fill="#1e293b" stroke="#94a3b8" stroke-width="1.2" class="stroke-ss" />
                <!-- Bolt Holes -->
                <circle cx="410" cy="86" r="3" fill="#0f172a" stroke="#94a3b8" stroke-width="0.8" />
                <circle cx="550" cy="86" r="3" fill="#0f172a" stroke="#94a3b8" stroke-width="0.8" />

                <!-- Central Mounting Collar Connecting directly to Column -->
                <rect x="466" y="55" width="28" height="25" fill="#1e293b" stroke="#94a3b8" stroke-width="1.2" />

                <!-- Hermetic DB-25 Feedthrough Port -->
                <rect x="460" y="22" width="40" height="33" rx="1.5" fill="#0f172a" stroke="#94a3b8" stroke-width="1.2" />
                <!-- Gold-Plated Connector Pins -->
                <path d="M 466 26 L 466 32 M 471 26 L 471 32 M 476 26 L 476 32 M 481 26 L 481 32 M 486 26 L 486 32 M 491 26 L 491 32" stroke="#eab308" stroke-width="1.2" />
                <rect x="463" y="18" width="34" height="4" fill="#eab308" opacity="0.8" />

                <!-- KF-25 Vacuum Pumping Port (Left Arm) -->
                <path d="M 430 80 L 430 45 L 415 45 L 415 38 L 445 38 L 445 80" fill="#1e293b" stroke="#94a3b8" stroke-width="1" />
                <line x1="410" y1="38" x2="450" y2="38" stroke="#cbd5e1" stroke-width="1.5" />

                <!-- Pirani Sensor Gauge & Helium Gas Inlet Port (Right Arm) -->
                <path d="M 530 80 L 530 50 L 545 50 L 545 42 L 515 42 L 515 80" fill="#1e293b" stroke="#94a3b8" stroke-width="1" />
                <line x1="510" y1="42" x2="550" y2="42" stroke="#cbd5e1" stroke-width="1.5" />

                <text x="425" y="14" font-size="8" font-family="ui-monospace, monospace" fill="#94a3b8">HERMETIC DB-25 & TOP PORTS</text>
            </g>

            <!-- ======================================================== -->
            <!-- SUBSYSTEM 4: L-SHAPED OFHC COPPER SAMPLE HOLDER BLOCK     -->
            <!-- (NO PCB! PURE MACHINED COPPER STAGE WITH SENSOR & HEATER)-->
            <!-- ======================================================== -->
            <g id="group-holder" class="cad-group part-transition" data-id="holder" data-mat="cu">
                <!-- L-Shaped Solid OFHC Copper Block (40 x 50 x 30 mm) -->
                <!-- Base footprint and vertical mounting wall -->
                <path d="M 458 410 L 502 410 L 502 475 L 474 475 L 474 455 L 458 455 Z" 
                      fill="url(#cu-holder-gradient)" stroke="#f59e0b" stroke-width="1.2" class="holder-copper-body" />
                
                <!-- NPT Coupling Thread to Central Rod -->
                <rect x="475" y="405" width="10" height="5" fill="#d97706" stroke="#f59e0b" stroke-width="0.8" />
                <line x1="475" y1="407" x2="485" y2="407" stroke="#1e293b" stroke-width="0.5" />

                <!-- Recessed Cavity 1: Pt100 Class A Platinum RTD Sensor -->
                <rect x="462" y="420" width="8" height="22" rx="1" fill="#0f172a" stroke="#38bdf8" stroke-width="0.9" />
                <circle cx="466" cy="431" r="2" fill="#38bdf8" />
                <text x="428" y="434" font-size="7" font-family="ui-monospace, monospace" fill="#38bdf8">Pt100 RTD</text>

                <!-- Recessed Cavity 2: 20W/50W Cartridge Heater Cylinder -->
                <rect x="488" y="420" width="8" height="26" rx="1" fill="#0f172a" stroke="#ef4444" stroke-width="0.9" />
                <line x1="492" y1="423" x2="492" y2="443" stroke="#ef4444" stroke-width="1" stroke-dasharray="2 1" />
                <text x="508" y="434" font-size="7" font-family="ui-monospace, monospace" fill="#ef4444">Cartridge Heater</text>

                <!-- Sample Mounting Polished Flat Face (10 x 10 mm Chip Site) -->
                <rect x="466" y="460" width="28" height="10" fill="#1e293b" stroke="#e2e8f0" stroke-width="0.8" />
                <!-- Silicon Chip Substrate -->
                <rect x="472" y="462" width="16" height="6" fill="#0f172a" stroke="#94a3b8" stroke-width="0.7" />

                <!-- Machined Mounting Holes for Brass Screws (No PCB) -->
                <circle cx="463" cy="414" r="1.5" fill="#0f172a" stroke="#f59e0b" stroke-width="0.7" />
                <circle cx="497" cy="414" r="1.5" fill="#0f172a" stroke="#f59e0b" stroke-width="0.7" />

                <text x="445" y="495" font-size="8" font-family="ui-monospace, monospace" fill="#f59e0b">OFHC CU SAMPLE HOLDER</text>
            </g>

            <!-- ======================================================== -->
            <!-- ENGINEERING TITLE BLOCK (CLEAN MINIMAL TECHNICAL METRICS) -->
            <!-- ======================================================== -->
            <g class="cad-title-block" font-family="ui-monospace, monospace" font-size="8">
                <rect x="680" y="510" width="290" height="98" fill="#0f172a" stroke="#334155" stroke-width="1" />
                <line x1="680" y1="535" x2="970" y2="535" stroke="#334155" stroke-width="0.5" />
                <line x1="680" y1="560" x2="970" y2="560" stroke="#334155" stroke-width="0.5" />
                <line x1="680" y1="585" x2="970" y2="585" stroke="#334155" stroke-width="0.5" />
                <line x1="830" y1="535" x2="830" y2="608" stroke="#334155" stroke-width="0.5" />

                <text x="690" y="527" font-weight="bold" fill="#f8fafc">DWG: USTH-CRYO-CAD-V9.16</text>
                <text x="690" y="550" fill="#94a3b8">SYSTEM: MODULAR CRYOSTAT</text>
                <text x="840" y="550" fill="#94a3b8">SCALE: 1:3</text>
                <text x="690" y="575" fill="#94a3b8">AUTHOR: NGUYEN XUAN TAI</text>
                <text x="840" y="575" fill="#38bdf8">T_BASE: 77 K</text>
                <text x="690" y="600" fill="#94a3b8">MATERIALS: Cu-OFHC / SS304L</text>
                <text x="840" y="600" fill="#94a3b8">STATUS: PASSED</text>
            </g>
        </svg>
    </div>

    <!-- Integrated Telemetry & Engineering Specs Strip (Anti-UI-Slop) -->
    <div class="telemetry-bar">
        <div class="telemetry-cell">
            <span class="cell-k">ACTIVE COMPONENT</span>
            <span class="cell-v highlight" id="hud-name">System Assembly (Section A-A)</span>
        </div>
        <div class="telemetry-cell">
            <span class="cell-k">MATERIAL SPECIFICATION</span>
            <span class="cell-v" id="hud-mat">Cu-OFHC (99.99%) & AISI 304L</span>
        </div>
        <div class="telemetry-cell">
            <span class="cell-k">THERMAL PERFORMANCE</span>
            <span class="cell-v" id="hud-thermal">k ≈ 1200 W/m·K at 80 K (Cryogenic Cu)</span>
        </div>
        <div class="telemetry-cell">
            <span class="cell-k">MECHANICAL COUPLING</span>
            <span class="cell-v" id="hud-role">NPT threaded cold finger + DB-25 feedthrough</span>
        </div>
    </div>
</div>

<style>
/* Anti-UI-Slop Scoped Styling */
.cryo-cad-wrapper {
    margin: 2rem 0;
    border: 1px solid #334155;
    background: #090d16;
    border-radius: 6px;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #f8fafc;
}

/* Header Bar */
.cad-header-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    background: #0f172a;
    border-bottom: 1px solid #1e293b;
}

.cad-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.cad-badge {
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    background: #1e293b;
    color: #38bdf8;
    border: 1px solid #334155;
}

.cad-model-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #f1f5f9;
}

/* Segmented Control */
.segmented-control {
    display: inline-flex;
    background: #0b0f19;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 2px;
    gap: 2px;
}

.seg-btn {
    border: none;
    background: transparent;
    color: #94a3b8;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.3rem 0.65rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s ease;
}

.seg-btn:hover {
    color: #f8fafc;
}

.seg-btn.active {
    background: #1e293b;
    color: #38bdf8;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
}

/* Material Pills */
.material-pills {
    display: flex;
    gap: 0.3rem;
}

.mat-pill {
    border: 1px solid #334155;
    background: transparent;
    color: #94a3b8;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    cursor: pointer;
    font-family: ui-monospace, monospace;
    transition: all 0.15s ease;
}

.mat-pill:hover {
    color: #f1f5f9;
    border-color: #64748b;
}

.mat-pill.active {
    background: rgba(56, 189, 248, 0.1);
    color: #38bdf8;
    border-color: #0284c7;
}

/* Thermal Simulation Bar */
.thermal-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
    background: #0b1120;
    border-bottom: 1px solid #1e293b;
    font-size: 0.75rem;
}

.thermal-status-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.thermal-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
}

.thermal-label {
    font-family: ui-monospace, monospace;
    color: #38bdf8;
}

.thermal-slider-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.temp-readout {
    font-family: ui-monospace, monospace;
    font-weight: 700;
    color: #38bdf8;
    min-width: 42px;
}

.temp-slider {
    accent-color: #38bdf8;
    width: 120px;
    cursor: pointer;
}

.temp-bound {
    font-family: ui-monospace, monospace;
    color: #64748b;
    font-size: 0.7rem;
}

.thermal-meta {
    display: flex;
    gap: 1rem;
    font-family: ui-monospace, monospace;
    color: #94a3b8;
}

.thermal-meta strong {
    color: #e2e8f0;
}

/* CAD Viewport */
.cad-viewport {
    background: #070a12;
    padding: 0.5rem;
    display: flex;
    justify-content: center;
}

.cad-svg-sheet {
    width: 100%;
    height: auto;
    max-height: 640px;
}

/* Vector Elements Interactivity */
.cad-group {
    cursor: pointer;
    transition: opacity 0.25s ease, filter 0.25s ease;
}

.cad-group:hover {
    filter: drop-shadow(0 0 4px rgba(56, 189, 248, 0.8));
}

.cad-group.dimmed {
    opacity: 0.15 !important;
}

.cad-group.selected {
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 1));
}

/* Transitions for Exploded View */
.part-transition {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
}

/* Exploded State Coordinates */
[data-view-state="exploded"] #group-feedthrough {
    transform: translateY(-50px);
}
[data-view-state="exploded"] #group-chamber {
    transform: translateY(90px);
    opacity: 0.4;
}
[data-view-state="exploded"] #group-holder {
    transform: translate(65px, 20px);
}
[data-view-state="exploded"] #group-column {
    transform: translateY(-5px);
}

/* Telemetry Strip */
.telemetry-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    background: #0b0f19;
    border-top: 1px solid #1e293b;
    padding: 0.75rem 1rem;
    gap: 0.75rem;
}

.telemetry-cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
}

.cell-k {
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    color: #64748b;
    letter-spacing: 0.05em;
}

.cell-v {
    font-size: 0.75rem;
    color: #cbd5e1;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cell-v.highlight {
    font-weight: 600;
    color: #38bdf8;
}
</style>

<script>
// Precision Client Script
document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("cryo-cad-app");
    if (!container) return;

    const segBtns = container.querySelectorAll(".seg-btn");
    const matPills = container.querySelectorAll(".mat-pill");
    const groups = container.querySelectorAll(".cad-group");
    const thermalBar = document.getElementById("thermal-bar");
    const tempSlider = document.getElementById("temp-slider");
    const tempDisplay = document.getElementById("temp-display");
    const statusText = document.getElementById("thermal-status-text");
    const thermalDot = document.getElementById("thermal-dot");
    const fluxArrows = document.getElementById("flux-arrows");
    const vacDisplay = document.getElementById("vac-display");
    const powerDisplay = document.getElementById("power-display");

    // Gradients
    const colTop = document.getElementById("grad-col-top");
    const colMid = document.getElementById("grad-col-mid");
    const colBot = document.getElementById("grad-col-bot");
    const holder1 = document.getElementById("grad-holder-1");
    const holder2 = document.getElementById("grad-holder-2");

    // HUD Elements
    const hudName = document.getElementById("hud-name");
    const hudMat = document.getElementById("hud-mat");
    const hudThermal = document.getElementById("hud-thermal");
    const hudRole = document.getElementById("hud-role");

    const hudDatabase = {
        feedthrough: {
            name: "Top Flange & Hermetic DB-25 Feedthrough",
            mat: "AISI 304L Stainless Steel + Gold-plated Pins",
            thermal: "Thin-wall SS neck minimizes ambient 300 K thermal conduction.",
            role: "Direct structural anchor to central column; 24-channel multi-terminal signal routing."
        },
        column: {
            name: "Central OFHC Cu Cold Finger & Baffles",
            mat: "OFHC Copper (ASTM B170, 99.99% Cu) - Solid ⌀ 20 mm",
            thermal: "k ≈ 401 W/m·K (300K) → 1200+ W/m·K (80K)",
            role: "Primary cryogenic conduction path; 3 copper baffles shield blackbody radiation."
        },
        chamber: {
            name: "Demountable Vacuum Chamber Jacket",
            mat: "AISI 304L Stainless Steel (⌀ 114 mm OD, 3 mm Wall)",
            thermal: "High-vacuum thermal insulation cavity (< 2 × 10⁻⁵ mbar)",
            role: "Suppresses convective/conductive gas leaks; slides downward to expose sample stage."
        },
        holder: {
            name: "L-Shaped OFHC Copper Sample Holder",
            mat: "Solid Machined OFHC Copper (40 × 50 × 30 mm)",
            thermal: "Rapid thermal response (τ < 180s); direct NPT thread coupling to cold finger.",
            role: "Holds semiconductor sample; houses Pt100 RTD sensor and 20W/50W cartridge heater."
        }
    };

    // 1. View Switching
    segBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            segBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");

            const view = btn.getAttribute("data-view");
            container.setAttribute("data-view-state", view);

            if (view === "thermal") {
                if (thermalBar) thermalBar.style.display = "flex";
                if (fluxArrows) fluxArrows.style.opacity = "1";
                updateThermalState(tempSlider ? tempSlider.value : 80);
            } else {
                if (thermalBar) thermalBar.style.display = "none";
                if (fluxArrows) fluxArrows.style.opacity = "0";
                resetGradients();
            }
        });
    });

    // 2. Material Filters
    matPills.forEach(pill => {
        pill.addEventListener("click", () => {
            matPills.forEach(p => p.classList.remove("active"));
            pill.classList.add("active");

            const mat = pill.getAttribute("data-mat");
            groups.forEach(g => {
                if (mat === "all") {
                    g.classList.remove("dimmed");
                } else {
                    const gMat = g.getAttribute("data-mat");
                    g.classList.toggle("dimmed", gMat !== mat);
                }
            });
        });
    });

    // 3. Hover / Click Inspector
    groups.forEach(g => {
        g.addEventListener("mouseenter", () => {
            const id = g.getAttribute("data-id");
            updateHud(id);
        });

        g.addEventListener("click", () => {
            groups.forEach(item => item.classList.remove("selected"));
            g.classList.add("selected");
            const id = g.getAttribute("data-id");
            updateHud(id);
        });
    });

    function updateHud(id) {
        const data = hudDatabase[id];
        if (!data) return;
        hudName.textContent = data.name;
        hudMat.textContent = data.mat;
        hudThermal.textContent = data.thermal;
        hudRole.textContent = data.role;
    }

    // 4. Thermal Slider Cooldown Simulation
    if (tempSlider) {
        tempSlider.addEventListener("input", (e) => {
            updateThermalState(e.target.value);
        });
    }

    function updateThermalState(val) {
        const kelvin = parseInt(val);
        tempDisplay.textContent = `${kelvin} K`;

        // Calculate fraction: 0 at 300K, 1 at 77K
        const f = (300 - kelvin) / (300 - 77);

        if (kelvin > 240) {
            statusText.textContent = "Room Temperature Ambient (300 K)";
            thermalDot.style.background = "#f59e0b";
            thermalDot.style.boxShadow = "0 0 6px #f59e0b";
            vacDisplay.textContent = "1.0 × 10⁻² mbar";
            powerDisplay.textContent = "0.0 W";
        } else if (kelvin > 110) {
            statusText.textContent = "Active Cryogenic Cooldown";
            thermalDot.style.background = "#38bdf8";
            thermalDot.style.boxShadow = "0 0 6px #38bdf8";
            vacDisplay.textContent = "4.2 × 10⁻⁴ mbar";
            powerDisplay.textContent = "12.5 W (PID)";
        } else {
            statusText.textContent = "Baseline Cryogenic Saturation (77 K – 80 K)";
            thermalDot.style.background = "#00f0ff";
            thermalDot.style.boxShadow = "0 0 8px #00f0ff";
            vacDisplay.textContent = "1.5 × 10⁻⁵ mbar";
            powerDisplay.textContent = "1.2 W (Holding)";
        }

        // Color interpolation between Amber (300K) and Cyan/Blue (77K)
        const r = Math.round(245 - f * (245 - 2));
        const g = Math.round(158 - f * (158 - 132));
        const b = Math.round(11 + f * (199 - 11));
        const cMid = `rgb(${r}, ${g}, ${b})`;
        const cBot = `rgb(3, ${Math.round(105 + f * 50)}, ${Math.round(161 + f * 94)})`;

        if (colTop) colTop.setAttribute("stop-color", kelvin > 180 ? "#f59e0b" : "#38bdf8");
        if (colMid) colMid.setAttribute("stop-color", cMid);
        if (colBot) colBot.setAttribute("stop-color", cBot);
        if (holder1) holder1.setAttribute("stop-color", cMid);
        if (holder2) holder2.setAttribute("stop-color", cBot);
    }

    function resetGradients() {
        if (colTop) colTop.setAttribute("stop-color", "#38bdf8");
        if (colMid) colMid.setAttribute("stop-color", "#0284c7");
        if (colBot) colBot.setAttribute("stop-color", "#0369a1");
        if (holder1) holder1.setAttribute("stop-color", "#0284c7");
        if (holder2) holder2.setAttribute("stop-color", "#0369a1");
    }
});
</script>
