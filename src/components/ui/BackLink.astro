---
interface Props {
    href: string;
    label: string;
}

const { href, label } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const targetHref = href.startsWith("http") ? href : `${basePath}/${href.replace(/^\//, "")}`;
---

<a href={targetHref} class="back-link inline-flex items-center gap-1.5 text-sm font-medium hover:text-accent transition-colors">
    &larr; Back to {label}
</a>