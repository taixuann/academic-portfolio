---
import { NAV_LINKS, PAGES } from "../../config";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const getHref = (href: string) => {
    if (href.startsWith("http")) return href;
    const clean = href.replace(/^\//, "");
    return clean ? `${basePath}/${clean}` : `${basePath}/`;
};

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav class="navbar">
    <ul class="nav-links">
        {
            NAV_LINKS.filter((link) => {
                const isHome = link.href === "/";
                const pageKey = isHome
                    ? "home"
                    : link.href.split("/").filter(Boolean)[0];
                const pageConfig = (PAGES as any)[pageKey];
                return link.isActive !== false && pageConfig?.isActive !== false;
            }).map((link) => {
                const targetHref = getHref(link.href);
                const targetPath = targetHref.replace(/\/$/, "") || "/";
                const isActive = link.href === "/" ? currentPath === targetPath : currentPath.startsWith(targetPath);
                return (
                    <li>
                        <a
                            href={targetHref}
                            class={`nav-link ${isActive ? "active" : "inactive"}`}
                        >
                            {link.label}
                            <span class="nav-link-line" />
                        </a>
                    </li>
                );
            })
        }
    </ul>
</nav>
